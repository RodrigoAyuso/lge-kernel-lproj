# Android 8.1 compatibility shared by V1 and Vee3.
# Merged by Lineage's TARGET_KERNEL_ADDITIONAL_CONFIG after the board defconfig.
CONFIG_ANDROID_BINDER_IPC=y
# CONFIG_ANDROID_BINDER_IPC_32BIT is not set
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_TIMERFD=y
CONFIG_ALARM_TIMER=y
CONFIG_FHANDLE=y
CONFIG_RD_GZIP=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# CONFIG_OABI_COMPAT is not set
CONFIG_USB_ANDROID_FUNCTIONFS=y
